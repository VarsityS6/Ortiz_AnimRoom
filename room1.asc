function room_Load()
{

}

function room_FirstLoad()
{
oClock.SetView(2);
oClock.Animate(0, 3, eRepeat, eNoBlock);
RemoveWalkableArea(2);
}

function hBarry_Look(Hotspot *theHotspot, CursorMode mode)
{

}

function hBarry_WalkOn(Hotspot *theHotspot)
{
  player.Say("This guy is freaking me out");
  Wait(1);
  RestoreWalkableArea(2);
  hBarry.Enabled = false;
}

function oBalloon_Interact(Object *theObject, CursorMode mode)
{
  WalkToObjectAndJumpUp(theObject, 80,  iBalloon);
  player.ChangeView (8);
  player.Animate (0, 3,  eOnce,  eBlock);
  Wait(20);
  player.Animate (1,  3, eOnce, eBlock);
  player.ChangeView(6);
}
